#include "mt7621.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	compatible = "wavlink,wn531ax2", "mediatek,mt7621-soc";
	model = "Wavlink WN-531AX2";

	aliases {
		led-boot = &led_status;
		led-failsafe = &led_red;
		led-running = &led_status;
		led-upgrade = &led_red;
		label-mac-device = &wifi0;
	};

	chosen {
		bootargs = "console=ttyS0,115200";
		bootargs-override = "console=ttyS0,115200";
	};

	leds {
		compatible = "gpio-leds";

		led_blue: blue {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&gpio 16 GPIO_ACTIVE_LOW>;
		};

		led_red: red {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
			gpios = <&gpio 17 GPIO_ACTIVE_LOW>;
		};

		led_wifi: wifi {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_WLAN;
			linux,default-trigger = "phy0tpt";
			gpios = <&gpio 3 GPIO_ACTIVE_LOW>;
		};

		led_status: status {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_INDICATOR;
			gpios = <&gpio 4 GPIO_ACTIVE_LOW>;
		};
	};

	keys {
		compatible = "gpio-keys-polled";
		poll-interval = <20>;

		reset {
			label = "reset";
			gpios = <&gpio 18 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		pair {
			label = "pair";
			gpios = <&gpio 15 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};

		turbo {
			label = "turbo";
			gpios = <&gpio 13 GPIO_ACTIVE_LOW>;
			linux,code = <BTN_1>;
		};

		touch {
			label = "touch";
			gpios = <&gpio 14 GPIO_ACTIVE_LOW>;
			linux,code = <BTN_0>;
		};
	};
};

&pcie {
	status = "okay";
};

&pcie1 {
	wifi0: wifi@0,0 {
		compatible = "mediatek,mt76";
		reg = <0x0000 0 0 0 0>;
		nvmem-cells = <&eeprom_factory_0>, <&macaddr_factory_4>;
		nvmem-cell-names = "eeprom", "mac-address";
		mediatek,disable-radar-background;
	};
};

&gmac0 {
	phy-mode = "trgmii";
	nvmem-cells = <&macaddr_factory_3fff4>;
	nvmem-cell-names = "mac-address";
};

&switch0 {
	ports {
		port@0 {
			status = "okay";
			label = "lan1";
		};

		port@1 {
			status = "okay";
			label = "lan2";
		};

		port@2 {
			status = "okay";
			label = "lan3";
		};

		port@3 {
			status = "okay";
			label = "lan4";
		};

		port@4 {
			status = "okay";
			label = "wan";
			nvmem-cells = <&macaddr_factory_3fffa>;
			nvmem-cell-names = "mac-address";
		};
	};
};

&state_default {
	gpio {
		groups = "uart2", "uart3";
		function = "gpio";
	};
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <50000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x0 0x30000>;
				read-only;
			};

			partition@30000 {
				label = "u-boot-env";
				reg = <0x30000 0x10000>;
				read-only;
			};

			partition@40000 {
				label = "product";
				reg = <0x40000 0x10000>;
				read-only;
			};

			partition@50000 {
				label = "factory";
				reg = <0x50000 0x40000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					eeprom_factory_0: eeprom@0 {
						reg = <0x0 0xe00>;
					};

					macaddr_factory_4: macaddr@4 {
						compatible = "mac-base";
						reg = <0x4 0x6>;
						#nvmem-cell-cells = <1>;
					};

					macaddr_factory_a: macaddr@a {
						compatible = "mac-base";
						reg = <0xa 0x6>;
					};

					macaddr_factory_3fff4: macaddr@3fff4 {
						compatible = "mac-base";
						reg = <0x3fff4 0x6>;
					};

					macaddr_factory_3fffa: macaddr@3fffa {
						compatible = "mac-base";
						reg = <0x3fffa 0x6>;
					};
				};
			};

			partition@90000 {
				compatible = "denx,fit";
				label = "firmware";
				reg = <0x90000 0xf70000>;
			};
		};
	};
};

&sdhci {
	status = "disabled";
};
